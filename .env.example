# --- Provider API keys (a provider without a key is listed as not configured) ---
YOU_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
FASTCRW_API_KEY=
PARALLEL_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# Optional credentials that only read account usage, for /v1/usage.
# Exa: a service key from the dashboard's "Service keys" tab.
# EXA_SERVICE_KEY=
# Parallel: an OAuth account access token (a normal API key is rejected).
# PARALLEL_ACCOUNT_TOKEN=

# With no key above, the gateway starts in demo mode: built-in providers demo-a and demo-b
# answer with generated results. DEMO_MODE=true keeps them beside real providers, false removes them.
# DEMO_MODE=auto

# --- Gateway ---
# PORT=4310
# Comma-separated bearer tokens clients must send; empty disables auth.
# Use name:token (e.g. alice:sk-1,ci:sk-2) to attribute calls to a client.
GATEWAY_API_KEYS=
# Postgres for the call log, balance snapshots, /v1/calls and /v1/usage.
# Without it calls are only written to the process log. Create the database first
# (createdb toolcallstack_search): the gateway does not start if it cannot connect.
# DATABASE_URL=postgres://localhost:5432/toolcallstack_search
# Also store every untouched upstream response body.
# STORE_RAW=true

# Outbound limits and list prices per provider, merged over the built-in defaults.
# PROVIDER_LIMITS={"tavily":{"rpm":1000},"brave":{"rpm":60,"concurrency":5}}
# PROVIDER_PRICING={"fastcrw":{"perRequestUsd":0.002},"firecrawl":{"perCreditUsd":0.0053}}
# Spend caps, so a free tier cannot be drained. A capped provider answers budget_exceeded.
# PROVIDER_BUDGETS={"tavily":{"monthly":{"credits":900}},"firecrawl":{"minRemaining":100},"you":{"daily":{"usd":0.5}}}
# Reuse identical successful answers for this many seconds unless a request says otherwise; 0 is off.
# CACHE_TTL_SECONDS=300
# Days to keep logged calls and stored raw bodies; 0 keeps them forever.
# CALL_LOG_RETENTION_DAYS=90
# RAW_RETENTION_DAYS=7
# Send OpenTelemetry traces to an OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Share rate limits, budgets and provider health between several instances (needs DATABASE_URL).
# SHARED_STATE=true
# See README.md for MAX_RETRIES, MAX_QUEUE_MS, BALANCE_POLL_SECONDS, CACHE_MAX_ENTRIES and others.
