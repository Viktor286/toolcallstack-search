{
  "name": "@toolcallstack/search-gateway",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "smoke": "node --env-file-if-exists=../../.env scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/bearer-auth": "^10.1.4",
